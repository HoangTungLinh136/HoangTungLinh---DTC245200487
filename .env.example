# =============================================================================
# QuizSystem Environment Configuration Template (.env.example)
# Copy this file to .env and configure strong secrets before running in production.
# NEVER commit .env to version control!
# =============================================================================

# Backend Application Configuration
PORT=3000
NODE_ENV=production
FRONTEND_URL=http://localhost
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# MySQL Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_USER=quiz_user
DB_PASSWORD=your_secure_mysql_user_password_here
DB_NAME=quizsystem
MYSQL_ROOT_PASSWORD=your_secure_mysql_root_password_here
MYSQL_DATABASE=quizsystem
MYSQL_USER=quiz_user
MYSQL_PASSWORD=your_secure_mysql_user_password_here

# phpMyAdmin Configuration
PMA_USER=root
PMA_PASSWORD=your_secure_mysql_root_password_here

# SMTP Mailpit Service
SMTP_HOST=mailpit
SMTP_PORT=1025

# Grafana Operational Dashboards
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here
